# Git configuration managed by chezmoi.
# Identity is intentionally left out of the repo; it is read from chezmoi
# data (set via `chezmoi -D git_user_name=...` or env) so a public repo has
# no personal info. If unset, git will ask you on first commit.

{{- $name  := default "" .git_user_name }}
{{- $email := default "" .git_user_email }}
{{- if (and (eq $name "") (env "GIT_USER_NAME")) }}{{ $name = env "GIT_USER_NAME" }}{{ end }}
{{- if (and (eq $email "") (env "GIT_USER_EMAIL")) }}{{ $email = env "GIT_USER_EMAIL" }}{{ end }}

[user]
	name = {{ $name | quote }}
	email = {{ $email | quote }}

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[status]
	submoduleSummary = true

[color]
	ui = auto

[diff]
	colorMoved = zebra

[core]
	excludesFile = ~/.gitignore_global
	autocrlf = input
	whitespace = fix,-indent-with-non-tab

[help]
	autocorrect = prompt

[fetch]
	prune = true

[credential]
	helper =