# Git configuration managed by chezmoi.
# Identity is local machine data and is never stored in this repository.

{{- if hasKey . "git_user_name" }}
{{- if .git_user_name }}
[user]
	name = {{ .git_user_name | quote }}
{{- if .git_user_email }}
	email = {{ .git_user_email | quote }}
{{- end }}
{{- end }}
{{- end }}

[init]
	defaultBranch = main

[pull]
	rebase = true

[push]
	default = simple
	autoSetupRemote = true

[status]
	submoduleSummary = true

[color]
	ui = auto

[diff]
	colorMoved = zebra

[core]
	excludesFile = ~/.gitignore_global
	autocrlf = input
	whitespace = fix,-indent-with-non-tab

[help]
	autocorrect = prompt

[fetch]
	prune = true

[credential]
	helper =
