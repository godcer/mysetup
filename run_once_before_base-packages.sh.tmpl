#!/usr/bin/env bash
set -eu

# Minimal bootstrap utilities needed by the rest of the setup.
# Chezmoi can clone the source with its built-in Git implementation, so this
# runs before the normal terminal package installer and makes the host ready
# for the remaining scripts.

OS_ID="$(. /etc/os-release && printf '%s' "${ID:-}")"
ID_LIKE="$(. /etc/os-release && printf '%s' "${ID_LIKE:-}")"

if [ "$(id -u)" -eq 0 ]; then SUDO=""; else SUDO="sudo"; fi
command -v sudo >/dev/null 2>&1 || [ -z "$SUDO" ] || {
  echo "sudo is required for package installation." >&2
  exit 1
}

case "$OS_ID $ID_LIKE" in
  *fedora*|*rhel*|*centos*)
    PM=dnf
    PACKAGES="git curl wget unzip gawk ncurses"
    ;;
  *arch*|*manjaro*|*endeavouros*|*garuda*|*cachyos*)
    PM=pacman
    PACKAGES="git curl wget unzip gawk ncurses"
    ;;
  *debian*|*ubuntu*|*kali*|*linuxmint*|*pop*)
    PM=apt
    PACKAGES="git curl wget unzip gawk ncurses-bin"
    ;;
  *)
    echo "Unsupported Linux distribution: $OS_ID (${ID_LIKE:-unknown})" >&2
    exit 1
    ;;
esac

case "$PM" in
  dnf)
    $SUDO dnf install -y --setopt=install_weak_deps=False $PACKAGES
    ;;
  pacman)
    $SUDO pacman -S --needed --noconfirm $PACKAGES
    ;;
  apt)
    $SUDO apt-get update -qq
    $SUDO apt-get install -y $PACKAGES
    ;;
esac

echo "Bootstrap packages ready: git, curl, wget, unzip, awk and clear."
